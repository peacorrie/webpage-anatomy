<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- Google Analytics and Microsoft Clarity are NOT loaded here. Both set
       non-essential cookies, so GDPR/ePrivacy requires opt-in consent
       before they run, not just a heads-up. cookie-consent.js loads them
       only after someone actually clicks "Accept" in the banner (or on
       return visits where that choice was already made). -->
  {% if page.url == "/" %}
  <title>{{ title or site.title }}</title>
  {% else %}
  <title>{{ title or site.title }} | {{ site.shortTitle }}</title>
  {% endif %}
  <meta name="description" content="{{ description or site.description }}" />
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="{{ site.shortTitle }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:title" content="{{ title or site.title }}" />
  <meta property="og:description" content="{{ description or site.description }}" />
  <meta property="og:image" content="{{ site.url }}/assets/img/og-share.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Webpage Anatomy: an interactive guide to how websites are built." />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title or site.title }}" />
  <meta name="twitter:description" content="{{ description or site.description }}" />
  <meta name="twitter:image" content="{{ site.url }}/assets/img/og-share.png" />

  <link rel="icon" href="/assets/img/favicon/favicon.ico" sizes="any" />
  <link rel="icon" href="/assets/img/favicon/favicon-32x32.png" type="image/png" sizes="32x32" />
  <link rel="icon" href="/assets/img/favicon/favicon-16x16.png" type="image/png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/assets/img/favicon/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Temporary CDN fonts per your request — swap to self-hosted once fonts are final.
       Loaded non-blocking (print-media swap trick): a real Lighthouse run measured
       this stylesheet costing ~860ms of render-blocking time otherwise. -->
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:ital,wght@0,400;0,600;0,700;0,800;0,900;1,700&family=Space+Mono:wght@400;700&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:ital,wght@0,400;0,600;0,700;0,800;0,900;1,700&family=Space+Mono:wght@400;700&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:ital,wght@0,400;0,600;0,700;0,800;0,900;1,700&family=Space+Mono:wght@400;700&display=swap" /></noscript>
  <!-- One combined file instead of 5 separate <link> tags: each was its own
       render-blocking round trip. Source stays split into 5 commented files
       in src/assets/css/; eleventy.config.js concatenates them at build time. -->
  <link rel="stylesheet" href="/assets/css/site.css" />
  <script>
    (function () {
      try {
        var saved = localStorage.getItem("wa-theme");
        if (saved) document.documentElement.setAttribute("data-theme", saved);
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <div class="cookie-banner" id="cookieBanner" role="region" aria-label="Cookie notice" hidden>
    <div class="container cookie-banner__inner">
      <p>This site uses cookies for analytics (Google Analytics, Microsoft Clarity) to see what's useful here and what isn't. No account, no ad targeting. <a href="/privacy-policy/">Read the privacy policy</a>.</p>
      <div class="cookie-banner__actions">
        <button type="button" class="btn btn--secondary" id="cookieDecline">Decline</button>
        <button type="button" class="btn btn--primary" id="cookieAccept">Accept</button>
      </div>
    </div>
  </div>

  <div class="grid-overlay" id="gridOverlay" aria-hidden="true">
    {% for i in range(0, 12) %}<span></span>{% endfor %}
  </div>
  <div class="scroll-progress" id="scrollProgress" role="progressbar" aria-label="Reading progress" aria-valuemin="0" aria-valuemax="100"></div>

  {% include "partials/nav.njk" %}

  <main id="main">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}
  {% if modals %}{% include "partials/modal.njk" %}{% endif %}

  <script src="/assets/js/cookie-consent.js"></script>
  <script src="/assets/js/theme.js"></script>
  <script src="/assets/js/scroll.js"></script>
  <script src="/assets/js/modal.js"></script>
  <script src="/assets/js/html2canvas-loader.js"></script>
  <script src="/assets/js/download.js"></script>
  <script src="/assets/js/email-capture.js"></script>
  <script src="/assets/js/quiz.js"></script>
  <script src="/assets/js/button-demo.js"></script>
  <script src="/assets/js/semantic-demo.js"></script>
  <script src="/assets/js/contrast-utils.js"></script>
  <script src="/assets/js/contrast-checker.js"></script>
  <script src="/assets/js/contrast-game.js"></script>
  <script src="/assets/js/style-guide.js"></script>
  <script src="/assets/js/box-model.js"></script>
  <script src="/assets/js/breakpoint-sim.js"></script>
  <script src="/assets/js/dictionary-filter.js"></script>
  <script src="/assets/js/color-system-demo.js"></script>
  <script src="/assets/js/form-demo.js"></script>
  <script src="/assets/js/head-demo.js"></script>
  <script src="/assets/js/page-load-demo.js"></script>
  <script src="/assets/js/image-shift-demo.js"></script>
  <script src="/assets/js/tooltip-position.js"></script>
</body>
</html>
