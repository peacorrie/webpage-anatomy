<dialog class="modal" id="contrastGameModal" aria-labelledby="contrastGameTitle">
  <div class="modal__header">
    <h2 id="contrastGameTitle" style="font-size: 1.25rem;">Guess the Contrast</h2>
    <button type="button" class="icon-btn" id="closeContrastGameModal" aria-label="Close dialog">✕</button>
  </div>
  <div class="modal__body">
