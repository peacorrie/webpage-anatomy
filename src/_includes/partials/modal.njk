          <div class="bk-mock__nav">
            <div class="bk-mock__logo"></div>
            <div class="bk-mock__links">
              <div class="bk-mock__link"></div>
              <div class="bk-mock__link"></div>
              <div class="bk-mock__link"></div>
            </div>
          </div>
          <div class="bk-mock__body">
            <div class="bk-mock__card"></div>
            <div class="bk-mock__card"></div>
            <div class="bk-mock__card"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="modal__footer">
    <span class="mono" style="font-size:0.75rem; opacity:.6;">No JavaScript is deciding this. CSS container queries are.</span>
    <button type="button" class="btn btn--primary" id="dismissBreakpointModal">Got it</button>
  </div>
</dialog>

<dialog class="modal modal-large" id="quizModal" aria-labelledby="quizModalTitle">
  <div class="modal__header">
    <h2 id="quizModalTitle" style="font-size: 1.25rem;">Take the Quiz</h2>
    <button type="button" class="icon-btn" id="closeQuizModal" aria-label="Close dialog">✕</button>
  </div>
  <div class="modal__body">
    <p>{{ quiz.length }} questions pulled straight from this page. Pick an answer to see it graded instantly.</p>
    <span class="quiz-score" id="quizScore" aria-live="polite">Score: 0 / {{ quiz.length }}</span>
    <form id="quizForm">
      <div class="quiz-list">
        {% for q in quiz %}
        {% set qIndex = loop.index %}
        <fieldset class="quiz-q" data-correct="{{ q.correct }}" data-explanation="{{ q.explanation }}">
          <legend>{{ qIndex }}. {{ q.question }}</legend>
          <div class="quiz-options">
            {% for opt in q.options %}
            <div class="quiz-option">
              <input type="radio" id="q{{ qIndex }}-opt{{ loop.index }}" name="q{{ qIndex }}" />
              <label for="q{{ qIndex }}-opt{{ loop.index }}">{{ opt }}</label>
            </div>
            {% endfor %}
          </div>
          <p class="quiz-feedback" role="status"></p>
        </fieldset>
        {% endfor %}
      </div>
    </form>
    <div class="quiz-result callout" id="quizResult" tabindex="-1" hidden>
      <p id="quizResultText" style="margin:0 0 .75rem;"></p>
      <button type="button" class="btn btn--secondary" id="quizRetry">Try Again</button>
    </div>
  </div>
  <div class="modal__footer">
    <span></span>
    <button type="button" class="btn btn--primary" id="dismissQuizModal">Done</button>
  </div>
</dialog>
