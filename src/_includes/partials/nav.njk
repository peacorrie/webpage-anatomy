<nav class="site-nav" aria-label="Primary">
  <div class="container site-nav__inner">
    <a class="site-nav__logo" href="/">
      <img src="/assets/img/logo/wa-brandmark.svg" alt="" width="32" height="32" />
      <span class="site-nav__wordmark">Webpage <em>Anatomy</em></span>
    </a>
    <ul class="site-nav__links">
      {% for item in site.nav %}
      <li><a href="{{ item.href }}">{{ item.label }}</a></li>
      {% endfor %}
    </ul>
    <div class="site-nav__tools">
      <button type="button" class="icon-btn" id="themeToggle" aria-pressed="false" title="Toggle dark mode">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"></path>
        </svg>
        <span class="sr-only">Toggle dark mode</span>
      </button>
      <button type="button" class="icon-btn" id="gridToggle" aria-pressed="false" title="Toggle grid (G)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
        </svg>
        <span class="sr-only">Toggle grid overlay</span>
      </button>
    </div>
  </div>
</nav>
